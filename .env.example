# EduPlay — Raqamli Viktorina Platformasi
#
# Nusxasini yarating va to'ldiring:  cp .env.example .env
#
# DIQQAT: .env hech qachon git'ga commit qilinmaydi! Sirli kalitlar faqat
# maxfiy muhitda (Vercel env / raqamli serverda) saqlanadi.

# --------------------------- Pusher (realtime) ------------------------------
# https://dashboard.pusher.com/apps dan oling. Frontend va server MUTLOQ
# bir xil app/klyuster ishlatishi kerak (VITE_* va PUSHER_*).
PUSHER_APP_ID="PUSHER_APP_ID"
PUSHER_KEY="PUSHER_KEY"
PUSHER_SECRET="PUSHER_SECRET"
PUSHER_CLUSTER="ap2"

# Frontend uchun (Vite: import.meta.env.VITE_*) — faqat ochiq key/cluster.
VITE_PUSHER_KEY="PUSHER_KEY"
VITE_PUSHER_CLUSTER="ap2"

# --------------------------- Upstash Redis (ixtiyoriy) ----------------------
# Ko'p instansli/Vercel serverless uchun holatni saqlash. Bo'sh bo'lsa
# in-memory (Map) rejim ishlaydi — faqat bitta instansa uchun yaroqli.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --------------------------- Server sozlamalari -----------------------------
# Port (default 3000).
PORT="3000"
# CORS ruxsat berilgan originlar, vergul bilan ajratiladi; bo'sh bo'lsa hammasi.
CORS_ORIGINS=""

# --------------------------- O'yin qoidalari (ixtiyoriy) ---------------------
# Har raundda nechta savol (default 1).
QUESTIONS_PER_ROUND="1"
# PIN necha soat amal qiladi (default 2).
PIN_LIFETIME_HOURS="2"

# --------------------------- Xavfsizlik cheklovlari (ixtiyoriy) --------------
# Chat xabarlari rate limit (oyna bo'yicha). Default 20 / 60s.
CHAT_RATE_LIMIT_MAX="20"
CHAT_RATE_LIMIT_WINDOW_SECONDS="60"
# PIN orqali ulanish urinishlari limiti. Default 10 / 60s.
JOIN_ATTEMPT_LIMIT="10"
JOIN_ATTEMPT_WINDOW_SECONDS="60"
# O'yin yaratish limiti (har IP uchun). Default 120 / 10 daq.
CREATE_GAME_LIMIT="120"
CREATE_GAME_WINDOW_MINUTES="10"
# O'qituvchi/student "presence" kechiktirish (grace) muddati (ms).
PRESENCE_TEACHER_GRACE_MS="10000"
PRESENCE_STUDENT_GRACE_MS="3000"

# --------------------------- Rivojlantirish (ixtiyoriy) ----------------------
# Vite HMR ni o'chirish (serverlodagi uchun foydali).
DISABLE_HMR="false"