# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Pusher Channels credentials (used by server.ts for broadcasting)
PUSHER_APP_ID="YOUR_PUSHER_APP_ID"
PUSHER_KEY="YOUR_PUSHER_KEY"
PUSHER_SECRET="YOUR_PUSHER_SECRET"
PUSHER_CLUSTER="YOUR_PUSHER_CLUSTER"

# Pusher Channels client credentials (exposed to the browser via Vite)
VITE_PUSHER_KEY="YOUR_PUSHER_KEY"
VITE_PUSHER_CLUSTER="YOUR_PUSHER_CLUSTER"

# Redis / Vercel KV credentials. The game state lives in a shared Redis store on
# Vercel (serverless lambdas are stateless). When these are missing the app
# falls back to in-memory storage, which is fine for local development.
# Create a store in the Vercel dashboard (Storage -> KV) or on Upstash, then
# set these env vars in Vercel (and optionally locally in .env).
KV_REST_API_URL="YOUR_KV_REST_API_URL"
KV_REST_API_TOKEN="YOUR_KV_REST_API_TOKEN"
